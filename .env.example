# Directus core
KEY=
SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8055
PORT=8055

# Database (Supabase Postgres -- use the session pooler, port 5432, NOT the
# transaction pooler on 6543. Directus runs DDL/prepared statements during
# bootstrap and schema apply, which transaction-mode pgbouncer breaks.)
DB_CLIENT=pg
DB_CONNECTION_STRING=
DB_SSL__REJECT_UNAUTHORIZED=false

# Storage (Cloudflare R2, S3-compatible)
STORAGE_LOCATIONS=r2
STORAGE_R2_DRIVER=s3
STORAGE_R2_KEY=
STORAGE_R2_SECRET=
STORAGE_R2_BUCKET=
STORAGE_R2_ENDPOINT=
STORAGE_R2_REGION=auto
STORAGE_R2_FORCE_PATH_STYLE=true
